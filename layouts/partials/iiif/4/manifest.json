{{- /*
  Site override of the theme's Presentation 4 manifest delegate
  (themes/projektemacher-base/layouts/partials/iiif/4/manifest.json).
  Adds support for 3D model resources (GLB, media type model/gltf-binary):
  each model becomes a canvas painted with an annotation of body type "Model"
  (convention of the IIIF 3D community group, the draft spec doesn't cover 3D yet).
  Pages without 3D model resources are delegated to the theme's shared
  Presentation 3 implementation, which also backs the theme's API 4 delegate.
  Note: the theme's iiif/3/common.json isn't reused here because it defaults
  the manifest behavior to "paged", while 3D model manifests use "individuals"
  (the map shaped `preview` param issue is fixed by the site's shadow of
  layouts/partials/iiif/3/thumbnail.json).
*/ -}}
{{- $version := partial "functions/iiif/presentation-version.html" . -}}
{{- $context := printf "http://iiif.io/api/presentation/%d/context.json" $version -}}

{{- /* Collect 3D model resources. External resources (leading "/" or "http") are referenced by URL, bundle resources are resolved. */ -}}
{{- $models := slice -}}
{{- range .Params.resources -}}
  {{- $src := .src -}}
  {{- $isExternal := or (hasPrefix $src "/") (hasPrefix $src "http") -}}
  {{- $isModel := false -}}
  {{- if $isExternal -}}
    {{- $isModel = eq (path.Ext $src) ".glb" -}}
  {{- else -}}
    {{- $res := $.Resources.Get $src -}}
    {{- if eq $res nil -}}
      {{- errorf "[iiif/4/manifest.json] Couldn't resolve resource %s for %s, 3D models are generated by scripts/3d-models.sh" $src $.RelPermalink -}}
    {{- end -}}
    {{- $isModel = eq $res.MediaType.MainType "model" -}}
  {{- end -}}
  {{- if $isModel -}}
    {{- $models = $models | append (dict "src" $src "external" $isExternal "params" .params) -}}
  {{- end -}}
{{- end -}}

{{- if eq (len $models) 0 -}}
  {{- /* No 3D content: fall back to the theme's shared implementation */ -}}
  {{- partial "iiif/3/manifest.json" . -}}
{{- else -}}
  {{- /* URL base, see iiif/3/manifest.json */ -}}
  {{- $urlBase := "" -}}
  {{- $localPath := printf "%s/" (substr (path.Dir .RelPermalink) 1) -}}
  {{- if or hugo.IsServer (not (isset .Site.Params "productioniiifurlprefix")) -}}
    {{- $urlBase = printf "%s%s" hugo.Sites.Default.BaseURL $localPath -}}
  {{- else -}}
    {{- $urlBase = printf "%s%s" .Site.Params.productionIIIFURLPrefix $localPath -}}
  {{- end -}}

  {{- $manifest := dict "@context" $context "type" "Manifest" "id" (.OutputFormats.Get "iiif-manifest").Permalink "viewingDirection" "left-to-right" -}}

  {{- /* 3D objects aren't paged, "individuals" instead of the theme's "paged" default */ -}}
  {{- $behavior := "individuals" -}}
  {{- with .Params.iiif.behavior -}}
    {{- $behavior = . -}}
  {{- end -}}
  {{- $manifest = $manifest | merge (dict "behavior" (slice $behavior)) -}}

  {{- with .Description -}}
    {{- $manifest = $manifest | merge (dict "summary" (partial "iiif/3/manifest-summary.json" $)) -}}
  {{- end -}}

  {{- /* Label and homepage, see iiif/3/common.json */ -}}
  {{- $label := partial "iiif/3/manifest-label.json" . -}}
  {{- $homepageLabel := dict $.Site.Language.Lang (slice (printf "%s: %s" .Site.Title .Title)) -}}
  {{- if hugo.IsMultilingual -}}
    {{- range where .Translations ".Lang" "!=" $.Site.Language.Lang -}}
      {{- $homepageLabel = $homepageLabel | merge (dict .Lang (slice (printf "%s: %s" .Site.Title .Title))) -}}
    {{- end -}}
  {{- end -}}
  {{- $homepage := slice (dict "id" .Permalink "type" "Text" "format" "text/html" "label" $homepageLabel) -}}

  {{- $manifest = $manifest | merge (dict "provider" (partialCached "iiif/3/provider.json" .)) -}}
  {{- $manifest = $manifest | merge (dict "homepage" $homepage) -}}
  {{- $manifest = $manifest | merge (dict "label" $label) -}}
  {{- $manifest = $manifest | merge (dict "requiredStatement" (partial "iiif/3/required-statement.json" .)) -}}

  {{- /* Manifest thumbnail: the resource named "preview", falling back to the first model's poster image */ -}}
  {{- $previewImg := "" -}}
  {{- $previewMatches := where .Params.resources "name" "preview" -}}
  {{- if gt (len $previewMatches) 0 -}}
    {{- $previewImg = .Resources.Get (index $previewMatches 0).src -}}
  {{- end -}}
  {{- range $models -}}
    {{- if and (eq $previewImg "") (not .external) -}}
      {{- $posterSrc := printf "%s.jpg" (strings.TrimSuffix (path.Base .src) (path.Ext .src)) -}}
      {{- with $.Resources.Get $posterSrc -}}
        {{- $previewImg = . -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
  {{- if and (ne $previewImg "") (hasPrefix (string $previewImg.MediaType) "image") -}}
    {{- $thumbnailRes := $previewImg.Resize "300x" -}}
    {{- $manifest = $manifest | merge (dict "thumbnail" (slice (dict "id" $thumbnailRes.Permalink "format" (string $thumbnailRes.MediaType) "type" "Image" "height" $thumbnailRes.Height "width" $thumbnailRes.Width))) -}}
  {{- end -}}

  {{- with .Params.iiif.metadata -}}
    {{- $manifest = $manifest | merge (dict "metadata" .) -}}
  {{- end -}}
  {{- with .Params.iiif.structure -}}
    {{- $manifest = $manifest | merge (dict "structures" .) -}}
  {{- end -}}
  {{- with .Params.iiif.rights -}}
    {{- $manifest = $manifest | merge (dict "rights" .) -}}
  {{- end -}}

  {{- $items := slice -}}
  {{- range $models -}}
    {{- $slug := strings.TrimSuffix (path.Base .src) (path.Ext .src) -}}
    {{- $canvasId := printf "%scanvas/%s" $urlBase $slug -}}
    {{- $annotationId := printf "%sannotation/%s" $urlBase $slug -}}

    {{- $pageLabel := dict "none" (slice $slug) -}}
    {{- with .params -}}
      {{- with .label -}}
        {{- $pageLabel = dict "none" (slice .) -}}
      {{- end -}}
    {{- end -}}
    {{- $canvas := dict "id" $canvasId "type" "Canvas" "label" $pageLabel -}}

    {{- /* Canvas thumbnail from the poster image (sibling file next to the GLB) */ -}}
    {{- if not .external -}}
      {{- $posterSrc := printf "%s.jpg" (strings.TrimSuffix .src (path.Ext .src)) -}}
      {{- with $.Resources.Get $posterSrc -}}
        {{- $thumbnailRes := .Resize "300x" -}}
        {{- $canvas = $canvas | merge (dict "thumbnail" (slice (dict "id" $thumbnailRes.Permalink "format" (string $thumbnailRes.MediaType) "type" "Image" "height" $thumbnailRes.Height "width" $thumbnailRes.Width))) -}}
      {{- end -}}
    {{- end -}}

    {{- /* Model ID: bundle resources use their permalink, external ones their URL */ -}}
    {{- $modelId := "" -}}
    {{- if .external -}}
      {{- if hasPrefix .src "http" -}}
        {{- $modelId = .src -}}
      {{- else -}}
        {{- $modelId = printf "%s%s" hugo.Sites.Default.BaseURL (strings.TrimPrefix .src "/") -}}
      {{- end -}}
    {{- else -}}
      {{- with $.Resources.Get .src -}}
        {{- $modelId = .Permalink -}}
      {{- end -}}
    {{- end -}}

    {{- $body := dict "id" $modelId "type" "Model" "format" "model/gltf-binary" -}}
    {{- $annotation := dict "id" (printf "%s/model" $annotationId) "type" "Annotation" "motivation" "painting" "body" $body "target" $canvasId -}}
    {{- $annotationPage := dict "id" $annotationId "type" "AnnotationPage" "items" (slice $annotation) -}}
    {{- $canvas = $canvas | merge (dict "items" (slice $annotationPage)) -}}
    {{- $items = $items | append $canvas -}}
  {{- end -}}

  {{- $manifest = $manifest | merge (dict "items" $items) -}}
  {{- $manifest | jsonify -}}
{{- end -}}
