{
    "@context": [
        "https://www.w3.org/ns/activitystreams",
        {
          "ostatus": "http://ostatus.org#",
          "atomUri": "ostatus:atomUri",
          "inReplyToAtomUri": "ostatus:inReplyToAtomUri",
          "conversation": "ostatus:conversation",
          "sensitive": "as:sensitive",
          "toot": "http://joinmastodon.org/ns#",
          "votersCount": "toot:votersCount",
          "expiry": "toot:expiry",
          "Hashtag": "as:Hashtag"
        }
      ],
    "type": "Person",
    "url": "{{ site.Params.social.mastodon.profilelink }}",
    "discoverable": true,
    "inbox": "{{ site.BaseURL }}inbox",
    "name": "{{ site.Params.author.name }}",
    {{- with site.Params.Description -}}
      "summary": "{{ . }}",
    {{- end -}}
    {{- with site.Params.activitypub -}}
      {{- if and (isset . "author") (ne .author "") -}}
        "id": "{{ site.BaseURL }}@{{ .author }}.json",
        "preferredUsername": "{{ .author }}",
      {{- end -}}
      {{- if and  (isset . "outbox") (ne .outbox "") -}}
        "outbox": "{{ site.BaseURL }}{{ .outbox }}",
      {{- end -}}
      {{- if and (isset . "icon") (ne .icon "") -}}
        {{ with resources.Get .icon }}
          "icon": {
            "type": "Image",
            "mediaType": "{{ .MediaType.Type }}",
            "url": "{{ .Permalink }}"
          },
        {{ end }}
      {{- end -}}
      {{- if and (isset . "image") (ne .image "") -}}
        {{- with resources.Get .image -}}
          "image": {
            "type": "Image",
            "mediaType": "{{ .MediaType.Type }}",
            "url": "{{ .Permalink }}"
          },
        {{- end -}}
      {{- end -}}

      {{- if and (isset . "links") (reflect.IsMap .links) -}}
        {{- $links := .links -}}
        "attachment": [
          {{- $i := 0 -}}
          {{- range $name, $value := $links -}}
            {
              "type": "PropertyValue",
              "name": {{ $name | jsonify }},
              "value": {{ $value | jsonify }}
            }
            {{- if lt $i (sub (len $links) 1) -}}
              ,
            {{- end -}}
            {{- $i = add $i 1 -}}
          {{- end -}}
        ]
      {{- end -}}
    {{- end -}}
}
