{
  "@context": "https://www.w3.org/ns/activitystreams",
  "name": "{{ .Site.Title }}",
  {{- with .Site.Params.Description -}}
    "summary": "{{ . }}",
  {{- end -}}
  "type": "OrderedCollection",
  {{- with .Site.Params.activitypub -}}
    {{- if and  (isset . "outbox") (ne .outbox "") -}}
      "id": "{{ $.Site.BaseURL }}{{ .outbox }}",
    {{- end -}}

    {{- $actor := "" -}}
    {{- if and (isset . "author") (ne .author "") -}}
      {{- $actor = printf "%s@%s.json" $.Site.BaseURL .author -}}
    {{- end -}}

    {{- $pages := where $.Site.RegularPages "Section" "post" -}}
    {{- $pages = where $pages "Params.displayinlist" "!=" false -}}
    "totalItems": {{ (len $pages) }},
    "orderedItems": [
      {{ range $i, $page := $pages  }}
        {{- $link := $page.Permalink -}}
        {{- with $page.OutputFormats.Get "html" -}}
          {{- $link = .Permalink -}}
        {{- end -}}
        {
          "@context": "https://www.w3.org/ns/activitystreams",
          "id": "{{ $link }}",
          "type": "Create",
          {{- if ne $actor "" -}}
            "actor": "{{ $actor }}",
          {{- end -}}
          "object": {
            "id": "{{ $link }}",
            "type": "Note",
            "content": {{ printf "<a href=\"%s\">%s</a>" $link $page.Title | jsonify }},
            "url": "{{ $link }}",
            {{- if ne $actor "" -}}
              "attributedTo": "{{ $actor }}",
            {{- end -}}
            "to": "https://www.w3.org/ns/activitystreams#Public",
            "published": {{ dateFormat "2006-01-02T15:04:05-07:00" .Date | jsonify }}
          }
        }
        {{- if lt $i (sub (len $pages) 1) -}}
          ,
        {{- end -}}
      {{ end }}
    ]
  {{- end -}}
}
