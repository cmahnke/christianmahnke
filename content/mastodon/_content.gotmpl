{{- $mastodonFile := "mastodon/mastodon-archive.json" -}}
{{- $mastodonMediaPath := "mastodon/media/" -}}
{{- $adapter := . -}}
{{- if ne site.Title "Christian Mahnke" -}}
  {{- $page := dict
    "content" (dict
      "mediaType" "text/markdown"
      "value" "**Mastodon Archive isn't working when included by another page**")
    "kind" "page"
    "path" "Mastodon Archive"
    "title" "Mastodon Archive"
    "params" (dict "metaPage" true
      "displayinlist" false
      "archive" false
      "news" false
      "sectionContent" false)
  -}}
  {{- $adapter.AddPage $page -}}
  {{- $adapter.EnableAllLanguages -}}
{{- else -}}
  {{- $data := dict -}}
  {{- warnf "[mastodon/_content.gotmpl] Generating content from %s" $mastodonFile -}}
  {{- with resources.Get $mastodonFile -}}
    {{ $data = . | transform.Unmarshal }}
  {{- else -}}
    {{- errorf "mastodon/_content.gotmpl] Failed to load %s" $mastodonFile -}}
  {{- end -}}
  {{- .EnableAllLanguages -}}

  {{- $structures := slice "statuses" "favourites" "mentions" -}}
  {{- range $structure := $structures -}}

    {{- range (index $data $structure) -}}

      {{- /* Boosts (reblogs) arrive as an activity wrapper with empty content and
             the original status nested under "reblog". Flatten the original
             status into the page and keep the booster for the label. */ -}}
      {{- $outer := . -}}
      {{- $source := . -}}
      {{- $booster := dict -}}
      {{- with .reblog -}}
        {{- $source = . -}}
        {{- with $outer.account -}}
          {{- $booster = dict "username" .username "url" .url -}}
        {{- end -}}
      {{- end -}}

      {{- $account := $source.account.username -}}
      {{- $content := $source.content -}}
      {{- $createdAt := $source.created_at -}}
      {{- $id := .id -}}
      {{- $media_attachments := slice -}}
      {{- with $source.media_attachments -}}
        {{- range . -}}
          {{- $mediaType := .type -}}
          {{- $url := .url -}}
          {{- $localMedia := path.Join $mastodonMediaPath (urls.Parse $url).Path -}}
          {{- with resources.Get $localMedia -}}
            {{- $url = .RelPermalink -}}
          {{- end -}}
          {{- $previewUrl := .preview_url -}}
          {{- if $previewUrl -}}
            {{- $localPreview := path.Join $mastodonMediaPath (urls.Parse $previewUrl).Path -}}
            {{- with resources.Get $localPreview -}}
              {{- $previewUrl = .RelPermalink -}}
            {{- end -}}
          {{- end -}}
          {{- $description := .description -}}
          {{- $media_attachments = $media_attachments | append (dict "type" $mediaType "url" $url "preview_url" $previewUrl "description" $description) -}}
        {{- end -}}
      {{- end -}}
      {{- $language := $source.language -}}
      {{- $reblogsCount := $source.reblogs_count -}}
      {{- $favouritesCount := $source.favourites_count -}}
      {{- $card := dict -}}
      {{- with $source.card -}}
        {{- $url := .url -}}
        {{- $title := .title -}}
        {{- $description := .description -}}
        {{- $card = dict "url" $url "title" $title "description" $description -}}
      {{- end -}}
      {{- $url := $source.url -}}
      {{- $repliesCount := $source.replies_count -}}
      {{- $tags := slice -}}
      {{- with $source.tags -}}
        {{- range . -}}
          {{- $name := .name -}}
          {{- $url := .url -}}
          {{- $tags = $tags | append (dict "name" $name "url" $url) -}}
        {{- end -}}
      {{- end -}}
      {{- $mentions := $source.mentions -}}
      {{- $reply := dict -}}
      {{- if and (ne $source.in_reply_to_id nil) -}}
        {{- $reply = dict "in_reply_to_id" $source.in_reply_to_id "in_reply_to_account_id" $source.in_reply_to_account_id -}}
      {{- end -}}
      {{- $poll := $source.poll -}}
      {{- $pinned := $source.pinned -}}
      {{- $favourited := $source.favourited -}}
      {{- $sensitive := $source.sensitive -}}
      {{- $spoilerText := $source.spoiler_text -}}
      {{- $type := $structure -}}
      {{- if $booster -}}
        {{- $type = "reblog" -}}
      {{- end -}}

      {{ $content := dict
        "mediaType" "text/html"
        "value" $content
      }}
      {{ $page := dict
        "content" $content
        "kind" "page"
        "date" (time.AsTime $createdAt)
        "params" (dict
          "account" $account
          "created_at" $createdAt
          "id" $id
          "media_attachments" $media_attachments
          "language" $language
          "reblogs_count" $reblogsCount
          "favourites_count" $favouritesCount
          "card" $card
          "url" $url
          "replies_count" $repliesCount
          "_tags" $tags
          "mentions" $mentions
          "reply" $reply
          "poll" $poll
          "pinned" $pinned
          "favourited" $favourited
          "sensitive" $sensitive
          "type" $type
          "spoiler_text" $spoilerText
          "booster" $booster
        )
        "path" $id
      }}
      {{ $adapter.AddPage $page }}
    {{- end -}}
  {{- end -}}
{{- end -}}
